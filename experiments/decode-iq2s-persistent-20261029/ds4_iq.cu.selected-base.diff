+// Isolated opt-in token/window policy. No IQ1/light/IMMA or other upstream changes.
+std::atomic<int> g_iq2s_test_mode{-1};
+unsigned g_iq2s_test_cap = 0;  // test-only, single caller; production leaves mode -1
+Iq2sPersistTestCounts g_iq2s_counts{};
+bool iq2s_enabled() {
+    const int test = g_iq2s_test_mode.load(std::memory_order_relaxed);
+    if (test >= 0) return test == 1;
+    static const bool on = iq2s_policy::env_mode(std::getenv("STRATA_DS4_IQ_PERSIST"),
+                                                std::getenv("DS4_IQ_PERSIST")) == 1;
+    return on;
+}
+void iq2s_note(int kind) {
+    if (g_iq2s_test_mode.load(std::memory_order_relaxed) < 0) return;
+    if (kind == 0) ++g_iq2s_counts.gate;
+    else if (kind == 1) ++g_iq2s_counts.down;
+    else ++g_iq2s_counts.fallback;
+}
+// One process-wide dispatch receipt, never a throughput counter. Test overrides stay silent.
+void iq2s_production_notice(const char* kind, unsigned blocks) {
+    if (g_iq2s_test_mode.load(std::memory_order_relaxed) >= 0) return;
+    static std::atomic_flag once = ATOMIC_FLAG_INIT;
+    if (!once.test_and_set(std::memory_order_relaxed))
+        std::fprintf(stderr, "IQ2_S_PERSIST dispatch kind=%s blocks=%u\n", kind, blocks);
+}
+template <auto K>
+unsigned iq2s_grid(const Args& a, dim3 grid) {
+#if defined(STRATA_USE_HIP) || defined(MAYA_DS4_IQ_ONLY)
+    (void) a; (void) grid; return 0;
+#else
+    if (!iq2s_enabled()) return 0;
+    int dev = -1, major = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 64) { (void) cudaGetLastError(); return 0; }
+    static std::atomic<int> known[64]; // per kernel specialization and physical device; -1 query failed
+    int resident = known[dev].load(std::memory_order_relaxed);
+    if (resident == 0) {
+        int sms = 0, per = 0;
+        const bool ok = cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev) == cudaSuccess &&
+            major >= 8 && cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, dev) == cudaSuccess &&
+            cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per, K, kThreads, 0) == cudaSuccess;
+        resident = ok ? iq2s_policy::resident_blocks(sms, per) : 0;
+        if (resident <= 0) { (void) cudaGetLastError(); resident = -1; }
+        known[dev].store(resident, std::memory_order_relaxed);
+    }
+    if (!iq2s_policy::geometry(a.n_embd, a.n_ff, grid.y)) return 0;
+    const long long items = (long long) grid.x * grid.y;
+    const unsigned cap = g_iq2s_test_mode.load(std::memory_order_relaxed) >= 0 ? g_iq2s_test_cap : 0;
+    return iq2s_policy::grid_blocks(items, resident, cap);
+#endif
+}
