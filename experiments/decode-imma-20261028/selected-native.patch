+                    xb[G][ib][1] = xv.y;
+                }
+                xs[G][ib][0] = c0 < b.ncol ? b.xd[(size_t) c0 * nsb + kb] : 0.0f;
+                xs[G][ib][1] = c0 + 1 < b.ncol ? b.xd[(size_t) (c0 + 1) * nsb + kb] : 0.0f;
+            }
+        }
+#pragma unroll
+        for (int ib = 0; ib < 8; ++ib) {
+            const int sh = 4 * (ib & 1);
+            uint32_t a[2][2];   // [row][word]: decode<kQ5_K>'s words 2 t, 2 t + 1
