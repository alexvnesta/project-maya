+    for (const auto& cols : {std::pair<int,int>{1,5}, {2,5}, {2,16}, {8,9}})
+        one(1280, 33, cols.first, cols.second, 16, 0, 0, 2, true);
+    for (int pattern = 1; pattern <= 4; ++pattern)
+        for (int nc : {1, 16}) one(5120, 17, nc, 0, 16, 0, 0, 1, false, pattern);
+    std::printf("Q5_K IMMA correctness: %d cases, failures so far %d\n", cases, g_fail);
+}
