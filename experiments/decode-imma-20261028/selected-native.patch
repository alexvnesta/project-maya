+// Correctness only: no timing loops, model files, cache data, or implicit benchmark.
+void test_mv_imma(cudaStream_t s) {
+    const int type = gg::iq::kQ5_K;
+    int cases = 0;
+    auto one = [&](int k, int n, int nc0, int nc1, int pad, int wo, int xo, int threshold, bool with_bias, int pattern = 0) {
+        const int jobs = nc1 ? 2 : 1, cs[2] = {nc0, nc1};
+        const size_t rb = gg::iq::row_bytes(type, k), ld = rb + pad, guard = 8, ycs = n + 3;
+        std::vector<uint8_t> packed = q_rand(type, n, k), weights(wo + ld * n, 0);
+        for (int row = 0; row < n; ++row)
+            std::memcpy(weights.data() + wo + row * ld, packed.data() + row * rb, rb);
+        const int maxc = std::max(nc0, nc1);
+        std::vector<int8_t> xq(xo + (size_t) k * maxc);
+        for (auto& v : xq) v = (int8_t) ((int) (rng() % 255) - 127);
+        std::vector<float> xd((size_t) (k / 32) * maxc), bias(n);
+        for (auto& v : xd) v = frand(0.05f);
+        if (pattern) {
+            for (size_t i = 0; i < xq.size(); ++i)
+                xq[i] = pattern == 4 ? 0 : pattern == 1 ? 127 : pattern == 2 ? -127 : (i % 2 ? -127 : 127);
+            for (auto& v : xd) v = pattern == 2 ? std::ldexp(1.0f, -140) : pattern == 3 ? 1.0e-20f : 0.125f;
+        }
+        for (auto& v : bias) v = frand(0.1f);
+        const float sentinel = 987.25f;
+        std::vector<float> initial(guard + ycs * maxc + guard, sentinel);
+        uint8_t* dw = dev(weights);
+        int8_t* dx = dev(xq);
+        float* ds = dev(xd), *db = dev(bias);
+        float *dy[2] = {dev(initial), jobs == 2 ? dev(initial) : nullptr};
+        gg::iq::MvJob j[2];
+        for (int i = 0; i < jobs; ++i) {
+            j[i].w = dw + wo; j[i].ld = ld; j[i].type = type; j[i].k = k; j[i].n = n;
+            j[i].ncol = cs[i]; j[i].xq = dx + xo; j[i].xd = ds;
+            j[i].y = dy[i] + guard; j[i].ycs = ycs;
+            j[i].bias = with_bias ? db : nullptr; j[i].alpha = with_bias ? -0.5f : 1.0f;
+        }
+        std::vector<float> want[2];
+        bool ok = true;
+        for (int on = 0; on < 2; ++on) {
+            for (int i = 0; i < jobs; ++i)
+                CU(cudaMemcpyAsync(dy[i], initial.data(), initial.size() * sizeof(float), cudaMemcpyHostToDevice, s));
+            gg::iq::set_imma(on ? threshold : 0);
+            if (!gg::iq::mv(j, jobs, s)) ok = false;
+            CU(cudaStreamSynchronize(s));
+            if (on) {
+                const auto counts = gg::iq::imma_test_counts();
+                const bool selected = nc0 >= threshold && (!nc1 || nc1 >= threshold) &&
+                                      pad % 16 == 0 && wo % 16 == 0 && xo % 8 == 0;
+                ok = ok && counts.ng1 == (unsigned) (selected && maxc <= 8) &&
+                     counts.ng2 == (unsigned) (selected && maxc > 8) &&
+                     counts.fallback == (unsigned) !selected;
+            }
+            for (int i = 0; i < jobs; ++i) {
+                auto got = host(dy[i], initial.size());
+                if (!on) want[i] = got;
+                else ok = ok && std::memcmp(want[i].data(), got.data(), got.size() * sizeof(float)) == 0;
+                for (size_t at = 0; at < got.size(); ++at) {
+                    const bool written = at >= guard && at < guard + ycs * cs[i] &&
+                                         (at - guard) % ycs < (size_t) n;
+                    if (!written) ok = ok && got[at] == sentinel;
+                    else ok = ok && std::isfinite(got[at]);
+                }
+            }
+        }
+        gg::iq::set_imma(0);
+        ++cases;
+        if (!ok) {
+            ++g_fail;
+            std::printf("IMMA FAIL k=%d n=%d columns=%d/%d pad=%d offsets=%d/%d threshold=%d bias=%d\n",
+                        k, n, nc0, nc1, pad, wo, xo, threshold, with_bias);
+        }
+        cudaFree(dw); cudaFree(dx); cudaFree(ds); cudaFree(db);
+        for (int i = 0; i < jobs; ++i) cudaFree(dy[i]);
+    };
+    // Include every column count and the full reduction widths used by the dense matrices.
+    for (const auto& shape : {std::pair<int,int>{768,136}, {1280,61}, {5120,40}, {8192,17}, {4096,33}})
+        for (int nc = 1; nc <= 16; ++nc) one(shape.first, shape.second, nc, 0, 0, 0, 0, 1, nc % 2);
