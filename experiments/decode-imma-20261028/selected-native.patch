+// CPU-visible dispatch policy for the opt-in Q5_K int8 tensor-core candidate.
+// This is also called by mv_nc; tests exercise its actual per-job predicate.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace strata::ds4::gguf::iq {
+inline int imma_check_device(const char* value) {
+    if (value == nullptr) return -1;
+    if (std::strcmp(value, "0") == 0) return 0;
+    if (std::strcmp(value, "1") == 0) return 1;
+    return -1;
+}
+inline bool imma_check_q8(const char* batch, const char* check) {
+    return batch != nullptr && check != nullptr &&
+           std::strcmp(batch, "1") == 0 && std::strcmp(check, "1") == 0;
+}
+constexpr bool q5k_imma_job_ok(std::uintptr_t weights, std::size_t row_bytes,
+                              std::uintptr_t activations, int columns, int min_columns) {
+    return min_columns > 0 && min_columns <= 16 && columns >= min_columns && columns <= 16 &&
+           (weights & 15u) == 0 && row_bytes % 16 == 0 && (activations & 7u) == 0;
+}
+}
--- /dev/null
+++ b/tests/ds4_q5k_imma_policy_test.cpp
