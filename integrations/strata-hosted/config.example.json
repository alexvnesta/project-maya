{
  "exe": "${DEPLOY_ROOT}/bin/maya-ds4",
  "args": [
    "--pack",
    "${MODEL_PACK}",
    "--gpus",
    "0,1",
    "--max-context",
    "524288",
    "--reserve-mib",
    "2048",
    "--cpu-threads",
    "24",
    "--tp",
    "1",
    "--dspark",
    "on",
    "--prefill-chunk",
    "1024",
    "--eos",
    "1",
    "--dspark-conf",
    "0.65",
    "--mmap-experts",
    "off",
    "--expert-profile",
    "${DEPLOY_ROOT}/state/expert-profile.bin",
    "--serve",
    "--vision",
    "on",
    "--ablate",
    "${DEPLOY_ROOT}/runtime-direction-L22.gguf",
    "--ablate-scale",
    "1"
  ],
  "cwd": "${DEPLOY_ROOT}/runtime-native-vision-v2",
  "tokenizer": "${QUALIFICATION_ROOT}/packs/ista-iq2-xs/tokenizer",
  "model_name": "deepseek-v4.1-flash-iq2-xs",
  "arch": "deepseek41",
  "log": "${DEPLOY_ROOT}/logs/deepseek-native.log",
  "engine_ready_s": 3600,
  "port": 18141,
  "host": "127.0.0.1",
  "gpu": [
    0,
    1
  ],
  "gpus_asked": true,
  "env": {
    "STRATA_DS4_DISK_SKIP_W": "0",
    "DS4_YOCO": "0",
    "STRATA_DS4_PROMPT_SKIP": "0",
    "STRATA_DS4_REUSE": "1",
    "STRATA_DS4_SLOT_KEEP": "1",
    "STRATA_DS4_AUTO_PIN": "1",
    "STRATA_DS4_SLOT_CAP": "4",
    "STRATA_DS4_SLOT_GB": "8",
    "STRATA_DS4_SLOT_DAYS": "7",
    "STRATA_DS4_SLOT_MIN": "1024",
    "STRATA_DS4_SLOT_DIR": "${DEPLOY_ROOT}/state/conversation-cache-${DIRECTION_SHA256}-s1-512k",
    "STRATA_DS4_DSPARK_CUM": "0",
    "DS4_DSPARK_CUM": "0",
    "DS4_DSPARK_MAX": "4",
    "DS4_REQUIRE_ALL_RAM": "1",
    "DS4_LANE_CAL": "${DEPLOY_ROOT}/state/lane-times.txt",
    "DS4_LT_STORE": "${DEPLOY_ROOT}/state/lt-picks.txt",
    "DS4_STREAM": "0",
    "STRATA_DS4_Q8_BATCH": "1",
    "DS4_Q8_CHECK": "1"
  },
  "answer_room": false,
  "reasoning_budget_tokens": 0,
  "repeat_stop_tokens": 0,
  "reasoning_loop_recovery": false,
  "fit_max_tokens": false,
  "hosted_default_effort": 100
}
