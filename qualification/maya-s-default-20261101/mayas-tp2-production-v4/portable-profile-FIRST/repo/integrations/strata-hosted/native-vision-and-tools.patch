+    def test_schema_with_client_tools_round_trip(self):
+        tools = [{"type": "function", "function": {"name": "search", "parameters": {
+            "type": "object", "properties": {"query": TEXT}, "required": ["query"]}}}]
+        script = ('</think>\n\n<tool_call>\n<function=search>\n<parameter=query>\nweather\n'
+                  '</parameter>\n</function>\n</tool_call>')
+        for stream in (False, True):
+            with self.subTest(stream=stream):
+                code, response = self.chat(script, tools=tools, stream=stream)
+                self.assertEqual(code, 200, response)
+                prompt = self.tok.decode(self.engine.last_prompt)
+                self.assertIn("This applies only to your final answer", prompt)
+                if stream:
+                    from serve.server import openai_collect
+                    chunks = [json.loads(line[6:]) for line in response.splitlines()
+                              if line.startswith("data: {")]
+                    response = openai_collect(iter(chunks))
+                choice = response["choices"][0]
+                self.assertEqual(choice["finish_reason"], "tool_calls")
+                call = choice["message"]["tool_calls"][0]
+                self.assertTrue(call["id"])
+                self.assertEqual(call["function"]["name"], "search")
+                self.assertEqual(json.loads(call["function"]["arguments"]), {"query": "weather"})
+                # The next request keeps tools declared, includes their result,
+                # and still validates the final answer against the schema.
+                history = [{"role": "user", "content": "Write the story after searching."},
+                           choice["message"], {"role": "tool", "tool_call_id": call["id"],
+                                               "content": "Sunny."}]
+                code, reply = self.chat(json.dumps(STORY), tools=tools, messages=history)
+                self.assertEqual(code, 200, reply)
+                self.assertEqual(json.loads(reply["choices"][0]["message"]["content"]), STORY)
+                code, reply = self.chat("Not JSON", tools=tools, messages=history)
+                self.assertEqual(code, 502, reply)
+                self.assertEqual(reply["error"]["code"], "structured_output_failed")
+
